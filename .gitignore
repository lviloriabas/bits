# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python

# Entornos virtuales y portable (muy pesados, se obtienen por separado)
.venv/
venv/
env/
portable/

# Caches de herramientas
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Outputs generados (se regeneran al correr la app)
output/
recortes_firmas/
build/

# Banco de trabajo: scripts sueltos, corridas de prueba, salidas de pytest y
# lo que haga falta dejar a mano un rato. Nada de aqui es del proyecto y nada
# de aqui se commitea; se puede borrar entero cuando estorbe.
tmp/

# Directorio de entrada (PDFs escaneados, descargables por separado)
input/*
!input/.gitkeep

# Archivo huérfano (de una mala redirección de shell)
=1.8.0

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Preferencias de la copia portable (se generan al usar la aplicación)
important_fields.json

# Preferencias de la interfaz: el tema, las casillas de salida, los filtros
# de cada ventana, la plantilla con la que se trabaja y que discrepancias se
# reclaman. Son elecciones de quien usa la maquina, no del repositorio, y el
# archivo se reescribe solo en cuanto alguien toca un control: versionarlo
# convertia cada casilla marcada en un cambio pendiente que bloqueaba el
# pull en la otra maquina. Los valores de partida estan en el codigo.
interfaz.json

.claude/
.vscode/
.agents/
.codex*/
.codex*/*
img/
AGENTS.md

# Cache de flota que arma el indexado de AirVault
airvault_flota.json

# Turno de cada libro en la ronda de comprobacion (local de cada instalacion,
# cambia en cada indexado y no dice nada fuera de su maquina)
book_ronda.json

# Preferencias del indexado (usuario, paginas por batch, politica de fecha).
# Cada instalacion las cambia sola en cuanto alguien toca un control, asi que
# tenerlas versionadas bloqueaba el pull en la otra maquina. El repositorio
# lleva los valores de partida en airvault.example.json.
airvault.json

# Memoria de libros que aprende el OCR: matricula de cada libro y extremos de
# fecha confirmados. Crece en cada corrida y es distinta en cada maquina; dos
# copias divergentes no se fusionan, se pisan.
book_matriculas.json
book_fechas.json
